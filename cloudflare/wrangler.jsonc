{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jam-masjid-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jam-masjid-db",
      "database_id": "5c6cfd54-9950-4229-acb7-9ffa14172901"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jam-masjid-media"
    }
  ]
}
